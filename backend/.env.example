PORT=3000
FRONTEND_ORIGIN=http://localhost:5173

# DeepSeek 仅用于流式对话；密钥只写在本地 .env，不要放到前端。
CHAT_API_KEY=
CHAT_MODEL=deepseek-flash
CHAT_BASE_URL=https://api.deepseek.com

# 可选：配置独立的 OpenAI 兼容向量服务后启用语义检索；留空使用关键词匹配。
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BASE_URL=https://api.openai.com/v1

# 配置后启用 MySQL 持久化；留空则使用本地 JSON 持久化。
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=ai_chat_dashboard
